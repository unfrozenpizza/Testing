&pinctrl {
    /* Unique pin control names for radar UART */
    uart1_radar_default: uart1_radar_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 26)>,
                    <NRF_PSEL(UART_RX, 0, 27)>;
        };
    };
    uart1_radar_sleep: uart1_radar_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 26)>,
                    <NRF_PSEL(UART_RX, 0, 27)>;
            low-power-enable;
        };
    };

    /* PDM pin assignments mapped to P0.04 and P0.05 */
    pdm0_default: pdm0_default {
        group1 {
            psels = <NRF_PSEL(PDM_CLK, 0, 4)>,
                    <NRF_PSEL(PDM_DIN, 0, 5)>;
        };
    };
    pdm0_sleep: pdm0_sleep {
        group1 {
            psels = <NRF_PSEL(PDM_CLK, 0, 4)>,
                    <NRF_PSEL(PDM_DIN, 0, 5)>;
            low-power-enable;
        };
    };
};

/* PC USB Console */
&uart0 {
    current-speed = <921600>;
};

/* Radar UART Hardware Link */
&uart1 {
    status = "okay";
    current-speed = <921600>;
    pinctrl-0 = <&uart1_radar_default>;
    pinctrl-1 = <&uart1_radar_sleep>;
    pinctrl-names = "default", "sleep";
};

/* Digital Microphone (DMIC / PDM) */
&pdm0 {
    status = "okay";
    queue-size = <8>;
    pinctrl-0 = <&pdm0_default>;
    pinctrl-1 = <&pdm0_sleep>;
    pinctrl-names = "default", "sleep";
};
